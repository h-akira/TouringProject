# Copy this file to `.env` and fill in your deployed API base URL.
# EXPO_PUBLIC_ variables are embedded in the app bundle in plain text,
# so put ONLY non-secret values here (an endpoint URL is fine; API keys are NOT).
EXPO_PUBLIC_API_BASE_URL=https://YOUR_API_ID.execute-api.ap-northeast-1.amazonaws.com/Prod

# ⚠️ The API key does NOT go here - there is deliberately no variable for it.
# It is typed into the app's settings screen and kept in expo-secure-store
# (src/api/apiKey.ts). Retrieve the value with the command in backend/README.md.

# --- Silence detection (VAD), all optional -------------------------------
# Recording stops and sends itself once the rider stops talking, so no screen
# tap is needed while riding (US-2.04).
#
# NOTE: these only set the BUILT-IN DEFAULTS. Tune the thresholds on the app's
# settings screen instead - it stores per-device values that win over these,
# and it shows a live dB meter to pick the number from. Set these only to
# change the starting point for a fresh install.
# Values live in src/api/vadSettings.ts.

# Level under which audio counts as silence, in dBFS (silence -160, max 0).
# Too low: recording never stops on a noisy ride (the max-duration timer is
# then the only backstop). Too high: it cuts off mid-sentence.
# EXPO_PUBLIC_SILENCE_THRESHOLD_DB=-40

# How long silence must last before sending. Too short cuts off natural pauses.
# EXPO_PUBLIC_SILENCE_DURATION_MS=3000

# Grace period after recording starts, during which silence is ignored.
# Without it the empty recording is sent before the rider begins to speak.
# EXPO_PUBLIC_SILENCE_GRACE_MS=5000

# Hard cap on recording length. This is the ONLY thing that stops a recording
# when the rider never speaks at all, since silence detection waits for speech.
# Capped at 180s in the app: the backend rejects audio over 2MB.
# EXPO_PUBLIC_MAX_RECORDING_MS=30000
